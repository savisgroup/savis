# URL của Payload CMS (không có dấu / ở cuối)
PAYLOAD_URL=https://cms.savis-group.com
# API key của user editor (tùy chọn, chỉ dùng phía server). Cần khi muốn xem bản Draft.
PAYLOAD_API_KEY=
# true = hiển thị cả bài Draft (cần PAYLOAD_API_KEY). Chỉ dùng cho môi trường dev/preview, KHÔNG bật ở production.
INSIGHTS_INCLUDE_DRAFTS=false
# Domain của website (dùng cho metadata/canonical)
NEXT_PUBLIC_SITE_URL=https://www.savis.vn
